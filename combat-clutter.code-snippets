  "Combat Clutter - Hero Section": {
    "prefix": "cc-hero",
    "body": [
      "import { BRAND, HERO_CONTENT } from '@/lib/brand/constants';",
      "import { Button } from '@/components/ui/Button';",
      "import Link from 'next/link';",
      "",
      "export function Hero() {",
      "  return (",
      "    <section className=\"relative h-screen flex items-center justify-center\">",
      "      <div className=\"absolute inset-0 bg-black/40\" />",
      "      <div className=\"relative z-10 text-center text-white max-w-4xl px-6\">",
      "        <h1 className=\"font-serif text-4xl md:text-6xl mb-6\">",
      "          {HERO_CONTENT.headline}",
      "        </h1>",
      "        <p className=\"text-xl md:text-2xl mb-8 text-white/90\">",
      "          {HERO_CONTENT.subheadline}",
      "        </p>",
      "        <Button asChild size=\"lg\">",
      "          <Link href={HERO_CONTENT.primaryCta.href}>",
      "            {HERO_CONTENT.primaryCta.text}",
      "          </Link>",
      "        </Button>",
      "        <p className=\"mt-8 text-sm text-white/70\">",
      "          {BRAND.established.display}",
      "        </p>",
      "      </div>",
      "    </section>",
      "  );",
      "}"
    ],
    "description": "Insert Combat Clutter Hero section component"
  },
  "Combat Clutter - Button Component": {
    "prefix": "cc-button",
    "body": [
      "import { cva, type VariantProps } from 'class-variance-authority';",
      "import { Slot } from '@radix-ui/react-slot';",
      "import { cn } from '@/lib/utils';",
      "",
      "const buttonVariants = cva(",
      "  'inline-flex items-center justify-center rounded-md font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent disabled:pointer-events-none disabled:opacity-50',",
      "  {",
      "    variants: {",
      "      variant: {",
      "        primary: 'bg-primary text-white hover:bg-primary/90',",
      "        secondary: 'bg-secondary text-primary hover:bg-secondary/80',",
      "        accent: 'bg-accent text-primary hover:bg-accent/90',",
      "        outline: 'border-2 border-primary bg-transparent hover:bg-primary hover:text-white',",
      "        ghost: 'hover:bg-primary/10',",
      "      },",
      "      size: {",
      "        sm: 'h-9 px-4 text-sm',",
      "        md: 'h-11 px-6 text-base',",
      "        lg: 'h-14 px-8 text-lg',",
      "      },",
      "    },",
      "    defaultVariants: {",
      "      variant: 'primary',",
      "      size: 'md',",
      "    },",
      "  }",
      ");",
      "",
      "interface ButtonProps",
      "  extends React.ButtonHTMLAttributes<HTMLButtonElement>,",
      "    VariantProps<typeof buttonVariants> {",
      "  asChild?: boolean;",
      "}",
      "",
      "export function Button({ className, variant, size, asChild = false, ...props }: ButtonProps) {",
      "  const Comp = asChild ? Slot : 'button';",
      "  return <Comp className={cn(buttonVariants({ variant, size, className }))} {...props} />;",
      "}",
      "",
      "export { buttonVariants };"
    ],
    "description": "Insert Combat Clutter Button component"
  },
  "Combat Clutter - Pricing Tier Card": {
    "prefix": "cc-pricing",
    "body": [
      "import { PRICING_TIERS, PRICING_DISCLAIMER } from '@/lib/brand/constants';",
      "import { cn } from '@/lib/utils';",
      "",
      "export function PricingTiers() {",
      "  return (",
      "    <section className=\"py-20 bg-secondary\">",
      "      <div className=\"max-w-7xl mx-auto px-6\">",
      "        <h2 className=\"font-serif text-3xl md:text-4xl text-center mb-4\">",
      "          Transparent Investment",
      "        </h2>",
      "        <p className=\"text-center text-neutral-600 mb-12 max-w-2xl mx-auto\">",
      "          No hidden fees. No surprise charges. Just honest pricing for exceptional results.",
      "        </p>",
      "        <div className=\"grid md:grid-cols-3 gap-8\">",
      "          {PRICING_TIERS.map((tier) => (",
      "            <div",
      "              key={tier.id}",
      "              className={cn(",
      "                'bg-white rounded-lg p-8 shadow-sm',",
      "                tier.featured && 'ring-2 ring-accent'",
      "              )}",
      "            >",
      "              {tier.featured && (",
      "                <span className=\"text-accent text-sm font-medium\">Most Popular</span>",
      "              )}",
      "              <h3 className=\"font-serif text-2xl mt-2\">{tier.name}</h3>",
      "              <p className=\"text-neutral-600 text-sm mt-1\">{tier.description}</p>",
      "              <p className=\"text-2xl font-medium mt-4\">{tier.priceRange}</p>",
      "              <p className=\"text-sm text-neutral-600\">{tier.duration}</p>",
      "              <ul className=\"mt-6 space-y-3\">",
      "                {tier.includes.map((item, i) => (",
      "                  <li key={i} className=\"flex items-start gap-2 text-sm\">",
      "                    <span className=\"text-accent\">✓</span>",
      "                    {item}",
      "                  </li>",
      "                ))}",
      "              </ul>",
      "              <p className=\"mt-6 text-xs text-neutral-600 italic\">",
      "                Best for: {tier.bestFor}",
      "              </p>",
      "            </div>",
      "          ))}",
      "        </div>",
      "        <p className=\"text-center text-sm text-neutral-600 mt-12 max-w-3xl mx-auto\">",
      "          {PRICING_DISCLAIMER}",
      "        </p>",
      "      </div>",
      "    </section>",
      "  );",
      "}"
    ],
    "description": "Insert Combat Clutter Pricing Tiers component"
  },
