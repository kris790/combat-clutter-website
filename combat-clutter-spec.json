        "required": "Always include 'Atlanta' or 'Atlanta, GA' on first mention per page",
        "seo_requirement": "Include location in title tags and meta descriptions"
      }
    },
    "type_definitions": {
      "priority_type": {
        "type": "enum",
        "values": ["p0", "p1", "p2", "p3"],
        "description": "P0 = blocker, P1 = high priority, P2 = medium, P3 = low"
      }
    },
    "test_cases": {
      "brand_display": [
        {
          "name": "hero_section_branding",
          "input": "Home page load",
          "expected": {
            "company_name_displayed": true,
            "name_format": "Combat Clutter LLC in legal context, Combat Clutter in conversational",
            "tagline_present": "Reclaim Your Space, Restore Your Calm",
            "location_mentioned": "Atlanta appears in copy"
          },
          "test_type": "brand_compliance"
        },
        {
          "name": "footer_copyright",
          "input": "Page footer",
          "expected": {
            "copyright_text": "© 2023 Combat Clutter LLC",
            "legal_name_used": true,
            "location_included": true
          },
          "test_type": "brand_compliance"
        }
      ],
      "form_validation": [
        {
          "name": "contact_form_submission",
          "input": {
            "email": "client@example.com",
            "name": "Jane Smith",
            "zip_code": "30303",
            "project_type": "residential"
          },
          "expected": {
            "status": "success",
            "confirmation_message": "Thank you for contacting Combat Clutter",
            "location_verification": "Atlanta service area check"
          },
          "test_type": "functional"
        }
      ]
    }
  },

  "decision_matrices": {
    "brand_usage": {
      "when_to_use_legal_name": {
        "conditions": ["Copyright notices", "Legal disclaimers", "Terms of Service", "Privacy Policy", "Business registration", "Footer"],
        "required_format": "Combat Clutter LLC",
        "examples": [
          "© 2023 Combat Clutter LLC. All rights reserved.",
          "Combat Clutter LLC Terms of Service"
        ]
      },
      "when_to_use_short_name": {
        "conditions": ["Marketing copy", "Blog posts", "CTAs", "Testimonials", "Email communications", "Social media"],
        "required_format": "Combat Clutter",
        "examples": [
          "Book Your Combat Clutter Consultation",
          "See Combat Clutter's latest transformation",
          "The Combat Clutter team helped us organize"
        ]
      }
    }
  },

  "error_handling": {
    "scenarios": {
      "brand_validation_error": {
        "detection": "Incorrect brand usage in code",
        "fallback_strategy": {
          "developer": "Show error in VS Code with suggested correction",
          "ci_cd": "Fail build with specific error message",
          "user": "Not visible to end users"
        },
        "recovery": "Run brand validation script and fix identified issues"
      }
    }
  },

  "testing_strategy": {
    "unit_tests": {
      "framework": "Jest + React Testing Library",
      "coverage_target": 80,
      "critical_paths": [
        "Brand usage in components",
        "Form validation and submission",
        "Combat Clutter CTA rendering"
      ]
    },
    "brand_tests": {
      "framework": "Custom script",
      "script_path": "scripts/validate-brand.js",
      "what_it_checks": [
        "Correct usage of 'Combat Clutter LLC' vs 'Combat Clutter'",
        "Presence of location references ('Atlanta')",
        "Correct copyright format",
        "SEO title tags include brand and location"
      ]
    }
  },

  "deployment": {
    "environments": {
      "development": {
        "url": "https://dev.combatclutter.com",
        "branch": "develop"
      },
      "staging": {
        "url": "https://staging.combatclutter.com",
        "branch": "staging"
      },
      "production": {
        "url": "https://combatclutter.com",
        "branch": "main",
        "brand_verification": {
          "copyright": "© 2023 Combat Clutter LLC",
          "title_tag": "Includes 'Combat Clutter LLC' and 'Atlanta'",
          "cta_buttons": "Include 'Combat Clutter'"
        }
      }
    }
  },

  "content_requirements": {
    "brand_voice": {
      "tone": "Warm but authoritative: 'We understand' not 'We're experts'",
      "focus": "Benefit-driven: 'Save time' not 'Organized shelves'",
      "language": "Jargon-free: 'Clutter' not 'High-density storage inefficiencies'"
    },
    "portfolio_projects": {
      "template": {
        "title_format": "[Room Type] Transformation with Combat Clutter | [Neighborhood], Atlanta",
        "narrative_structure": [
          "Client Challenge (2-3 sentences)",
          "Combat Clutter Solution (3-4 sentences with specific strategies)",
          "The Result (2-3 sentences with measurable outcomes)"
        ]
      }
    },
    "testimonials": {
      "format": "\"Combat Clutter transformed our [space]. [Specific result].\" - [Client Name], [Project Type]",
      "brand_inclusion": "Include 'Combat Clutter' in testimonial context when natural"
    }
  },

  "phase_planning": {
    "phase_1_mvp": {
      "duration": {
        "value": 8,
        "type": "number",
        "unit": "weeks"
      },
      "focus": "Core Combat Clutter website with lead capture",
      "in_scope": [
        "5 core pages (Home, Services, Portfolio, About, Contact)",
        "Multi-step contact form with Combat Clutter branding",
        "Portfolio grid with 10-15 Combat Clutter projects",
        "Transparent pricing display",
        "Basic SEO setup with Combat Clutter keywords",
        "HubSpot CRM integration",
        "Brand constants file (src/lib/brand/constants.ts)",
        "VS Code snippets for brand consistency"
      ],
      "out_of_scope": [
        "Blog/content hub",
        "E-commerce",
        "Client portal",
        "Advanced portfolio filters",
        "Email marketing automation"
      ]
    }
  },

  "vscode_setup": {
    "snippets_file": ".vscode/combat-clutter.code-snippets",
    "snippets": {
      "brand_name": {
        "prefix": "brand",
        "body": "Combat Clutter LLC",
        "description": "Insert legal brand name"
      },
      "brand_short": {
        "prefix": "brand-short",
        "body": "Combat Clutter",
        "description": "Insert conversational brand name"
      },
      "brand_tagline": {
        "prefix": "tagline",
        "body": "Reclaim Your Space, Restore Your Calm",
        "description": "Insert Combat Clutter tagline"
      },
      "brand_import": {
        "prefix": "import-brand",
        "body": "import { BRAND } from '@/lib/brand/constants';",
        "description": "Import BRAND constants"
      },
      "brand_location": {
        "prefix": "location",
        "body": "Atlanta, GA",
        "description": "Insert location"
      }
    },
    "search_replace_patterns": {
      "incorrect_to_correct": [
        { "find": "combat clutter", "replace": "Combat Clutter" },
        { "find": "CombatClutter", "replace": "Combat Clutter" },
        { "find": "Combat Clutter llc", "replace": "Combat Clutter LLC" },
        { "find": "Combat-Clutter", "replace": "Combat Clutter" },
        { "find": "COMBAT CLUTTER", "replace": "Combat Clutter" }
      ]
    },
    "recommended_extensions": [
      "esbenp.prettier-vscode",
      "bradlc.vscode-tailwindcss",
      "ms-vscode.vscode-typescript-next",
      "aaron-bond.better-comments"
    ]
  },

  "$defs": {
    "llm_response": {
      "type": "object",
      "required": ["status", "data", "validation", "metadata"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "partial_success", "error", "validation_failed"],
          "description": "Overall response status"
        },
        "data": {
          "type": ["object", "array", "string"],
          "description": "Primary response content (code, answer, etc.)"
        },
        "validation": {
          "type": "object",
          "required": ["schema_valid", "brand_compliant"],
          "properties": {
            "schema_valid": {
              "type": "boolean",
              "description": "Whether response conforms to schema"
            },
            "brand_compliant": {
              "type": "boolean",
              "description": "Whether content follows Combat Clutter branding guidelines"
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Non-blocking issues or recommendations"
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Validation errors if any"
            }
          }
        },
        "metadata": {
          "type": "object",
          "required": ["timestamp", "section_references", "phase_compliance"],
          "properties": {
            "timestamp": {
              "type": "string",
              "format": "date-time"
            },
            "section_references": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Specific section IDs referenced in response"
            },
            "phase_compliance": {
              "type": "boolean",
              "description": "Whether response is within phase_1_mvp scope"
            },
            "brand_compliance_check": {
              "type": "object",
              "properties": {
                "legal_name_used": {
                  "type": "boolean",
                  "description": "Whether 'Combat Clutter LLC' used correctly"
                },
                "short_name_used": {
                  "type": "boolean",
                  "description": "Whether 'Combat Clutter' used correctly"
                },
                "location_included": {
                  "type": "boolean",
                  "description": "Whether 'Atlanta' referenced appropriately"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}